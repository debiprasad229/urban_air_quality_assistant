# Environment Configuration for Frontend (Vite + React)
# Copy this file to .env and configure your variables

# Base URL pointing to the FastAPI backend API
# In local development, leave empty or '/api' to use the Vite dev server proxy
# In production on Vercel, set to your Render URL: e.g. https://urban-air-quality-api.onrender.com/api
VITE_API_BASE_URL=/api
