# Environment Configuration for Backend (FastAPI)
# Copy this file to .env and configure your variables

ENVIRONMENT=development
DEBUG=True
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# Google Gemini API Key (Optional)
# If omitted or expired, the backend transparently engages the deterministic rule fallback planner
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=10.0

# External Ingestion Timeouts
OPEN_METEO_TIMEOUT_SECONDS=3.0
OPENAQ_TIMEOUT_SECONDS=2.5

# In-Memory Cache (Open-Meteo weather forecasts)
CACHE_TTL_SECONDS=900
CACHE_MAX_ENTRIES=512
